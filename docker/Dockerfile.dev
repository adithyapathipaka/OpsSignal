# Development image for OpsSignal contributors.
# Includes: Rust stable (rustfmt + clippy), Python 3.11 via uv, Node 20 (ast-grep).
#
# Build:  docker compose build
# Shell:  docker compose run --rm dev
# Tests:  docker compose run --rm test   (or: docker compose run --rm dev bash scripts/check.sh)

FROM rust:1-slim-bookworm

ARG DEBIAN_FRONTEND=noninteractive

# ── System deps ───────────────────────────────────────────────────────────────
# build-essential + pkg-config: needed by ring (crypto), cc crate, and other
# Rust crates that compile C code.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git ca-certificates \
    build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*

# ── Node 20 LTS (for ast-grep) ────────────────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── uv + Python 3.11 ─────────────────────────────────────────────────────────
ENV PATH="/root/.local/bin:$PATH"
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && uv python install 3.11

# ── Rust dev components ───────────────────────────────────────────────────────
RUN rustup component add rustfmt clippy

WORKDIR /workspace

# Default: interactive shell. Override with docker compose run --rm dev <cmd>
CMD ["bash"]
