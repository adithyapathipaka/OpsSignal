#!/usr/bin/env bash
# pre-commit — fast local checks that mirror the CI jobs.
# Tests are intentionally omitted (run them before pushing, not on every commit).
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

pass() { echo -e "${GREEN}  ok${NC}  $*"; }
skip() { echo -e "skip  $*"; }
fail() { echo -e "${RED}FAIL${NC}  $*"; }

# ── Rust ──────────────────────────────────────────────────────────────────────

if ! command -v cargo &>/dev/null; then
  for candidate in "$HOME/.cargo/bin/cargo" "/opt/homebrew/bin/cargo" "/usr/local/bin/cargo"; do
    if [ -x "$candidate" ]; then
      export PATH="$(dirname "$candidate"):$PATH"
      break
    fi
  done
fi

if command -v cargo &>/dev/null; then
  echo "==> cargo fmt"
  if cargo fmt --all -- --check; then
    pass "cargo fmt"
  else
    fail "cargo fmt — run 'cargo fmt --all' to fix"
    exit 1
  fi

  echo "==> cargo clippy"
  # Exclude opssignal-py: the pyo3 extension-module crate requires Python dev
  # headers which may not be present on all dev machines. It is linted in CI.
  if cargo clippy --workspace --exclude opssignal-py --all-targets -- -D warnings; then
    pass "cargo clippy"
  else
    fail "cargo clippy"
    exit 1
  fi
else
  skip "cargo not found — Rust checks skipped (run scripts/setup-hooks.sh)"
fi

# ── ast-grep ──────────────────────────────────────────────────────────────────

if command -v sg &>/dev/null; then
  echo "==> ast-grep"
  if sg scan --config sgconfig.yml; then
    pass "ast-grep"
  else
    fail "ast-grep — structural lint violations found (see above)"
    exit 1
  fi
else
  skip "sg not found — ast-grep skipped (npm install -g @ast-grep/cli)"
fi

# ── Python ────────────────────────────────────────────────────────────────────

if command -v ruff &>/dev/null; then
  echo "==> ruff lint"
  if ruff check python/; then
    pass "ruff lint"
  else
    fail "ruff lint — run 'ruff check --fix python/' to auto-fix"
    exit 1
  fi

  echo "==> ruff format"
  if ruff format --check python/; then
    pass "ruff format"
  else
    fail "ruff format — run 'ruff format python/' to fix"
    exit 1
  fi
else
  skip "ruff not found — Python lint skipped (pip install ruff)"
fi
